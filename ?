# Imagen base con Node y R
FROM rocker/r-ver:4.3.1

# Instalar Node.js (v18 recomendado) y MySQL client
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    lsb-release \
    default-mysql-client \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Crear directorio de la app
WORKDIR /app

# Copiar archivos de Concerto
COPY . .

# Instalar dependencias de Node
RUN npm install

# Instalar paquetes R necesarios para Concerto
RUN R -e "install.packages(c('catR','psychotools','jsonlite','shiny','DBI','RMySQL'), repos='http://cran.rstudio.com/')"

# Puerto por defecto de Concerto
EXPOSE 4000

# Variables de entorno (se configuran en Render)
# DB_HOST, DB_USER, DB_PASS, DB_NAME
ENV NODE_ENV=production

# Comando de inicio
CMD ["npm", "start"]
